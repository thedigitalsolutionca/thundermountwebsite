# ==========================================================================
# Thunder Mounts — environment configuration
# Copy to .env and edit. NEVER commit the real .env file.
# ==========================================================================

APP_NAME="Thunder Mounts"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.thundermounts.com
APP_BASE_PATH=
APP_TIMEZONE=America/Los_Angeles
APP_KEY=

# --- Database (Hostinger cPanel values) -----------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_thundermounts
DB_USERNAME=u123456789_tmuser
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# --- Session / security ---------------------------------------------------
SESSION_NAME=tm_session
SESSION_LIFETIME=120
COOKIE_SECURE=true
TRUSTED_PROXIES=

# --- Mail (optional; SMTP settings can also be managed in the admin) ------
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=no-reply@thundermounts.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@thundermounts.com
MAIL_FROM_NAME="Thunder Mounts"
MAIL_REPLY_TO=thunder@thundermounts.com

# --- PayPal (optional; can also be managed in Admin → Settings → PayPal) --
# Leave blank to disable online payment until the merchant account is ready.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
