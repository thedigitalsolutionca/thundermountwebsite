# Uploaded media is served as static files only — never execute code here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
